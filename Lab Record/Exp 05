with open("sampleold.txt", "w") as file:
    file.write("apple\nhello\nsky\nbanana\n")

def remove():
                                                                                 # 1. Read all lines from the original file
    f = open("sampleold.txt", "r")
    lines = f.readlines()
    print(lines)
    f.close()

                                                                                 # 2. Open two separate files for writing
    fo = open("sampleold.txt", "w")
    fn = open("samplenew.txt", "w")

                                                                                 # 3. Filter lines based on the presence of "a"
    for line in lines:
        if "a" in line:
            fn.write(line)
        else:
            fo.write(line)

                                                                                 # 4. Properly close the resources
    fn.close()
    fo.close()

remove()

with open("samplenew.txt", "r", encoding="utf-8") as fn:
    print("samplenew.txt:", fn.read())

with open("sampleold.txt", "r", encoding="utf-8") as fo:
    print("sampleold.txt:", fo.read())
